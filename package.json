{
  "name": "ssg-with-react",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "minista",
    "build": "minista build",
    "preview": "minista preview",
    "clean": "trash ./dist",
    "storybook": "storybook dev --no-open -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc -b",
    "lint": "oxlint . --max-warnings=0",
    "lint-fix": "oxlint --fix .",
    "stylelint": "stylelint 'src/**/*.{css,scss,sass}'",
    "stylelint-fix": "stylelint --fix 'src/**/*.{css,scss,sass}'",
    "format": "oxfmt --check './{src,.storybook}/**/*.{js,jsx,ts,tsx}'",
    "format-fix": "oxfmt --write './{src,.storybook}/**/*.{js,jsx,ts,tsx}'",
    "test": "vitest",
    "test-run": "vitest run",
    "upgrade": "npx npm-check-updates -u",
    "upgrade-check": "npx npm-check-updates",
    "pre-commit": "npm run typecheck && npm run lint-fix && npm run stylelint-fix && npm run format-fix"
  },
  "browserslist": [
    "last 1 Chrome versions",
    "last 1 Edge versions",
    "last 1 Firefox versions",
    "last 1 Safari versions",
    "last 1 iOS versions",
    "last 1 ChromeAndroid versions"
  ],
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "classnames": "^2.5.1",
    "jsdom": "^29.1.1",
    "minista": "^4.0.6",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.15",
    "postcss-custom-media": "^12.0.1",
    "postcss-import": "^16.1.1",
    "postcss-mixins": "^12.1.2",
    "postcss-nested": "^7.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.4.6",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "volta": {
    "node": "24.16.0"
  }
}
